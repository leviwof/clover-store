# --- Database (Neon Postgres) ---
# Copy from the Neon dashboard: Connection Details -> connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# --- Better Auth ---
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---
# Public base URL used by the Better Auth browser client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
